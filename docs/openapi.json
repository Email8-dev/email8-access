        "responses": {
          "200": {
            "description": "Dry-run decision trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyTestOutcome"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/relations": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_relations",
        "responses": {
          "200": {
            "description": "ReBAC relations of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RelationRecordRow"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_relation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutRelationBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Relation stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationUpserted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid relation definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_relation",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Relation id to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Relation deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/relations/check": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_check_relation",
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "description": "Subject key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "relation",
            "in": "query",
            "description": "Relation name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "object",
            "in": "query",
            "description": "Object key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The check verdict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationCheckResult"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Liveness (version, build)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealth"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "AttributeUpserted": {
        "type": "object",
        "description": "An attribute upsert result.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `upserted`."
          }
        }
      },
      "Decision": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "allow"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason",
              "decision"
            ],
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "deny"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "DeleteAttributeQuery": {
        "type": "object",
        "description": "`DELETE /v1/admin/attributes` query - identifies the attribute.",
        "required": [
          "subject_id",
          "attr_key"
        ],
        "properties": {
          "attr_key": {
            "type": "string"
          },
          "subject_id": {
            "type": "string"
          },
          "target_env_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeleteRelationQuery": {
        "type": "object",
        "description": "`DELETE /v1/admin/relations` query - identifies the tuple.",
        "required": [
          "subject_type",
          "subject_id",
          "relation",
          "object_type",
          "object_id"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "object_type": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "subject_id": {
            "type": "string"
          },
          "subject_type": {
            "type": "string"
          },
          "target_env_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ListAttributesQuery": {
        "type": "object",
        "description": "`GET /v1/admin/attributes` query - list attributes for one subject (or\nall subjects in the env when omitted).",
        "properties": {
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_env_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LiveHealth": {
        "type": "object",
        "description": "The `GET /v1/health` liveness payload every service returns: the\nstatus string, the serving service's short name, build identity, and\n(when the process tracks them) the count of live connections.\n`service` and `active_connections` stay absent when a service does\nnot set them (e.g. the bus mounts the generic handler).",
        "required": [
          "status"
        ],
        "properties": {
          "active_connections": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Live socket count when the traffic counter is mounted."
          },
          "build": {
            "type": [
              "string",
              "null"
            ],
            "description": "Build hash (`sentin8::build_info::build_hash()`)."
          },
          "service": {
            "type": [
              "string",
              "null"
            ],
            "description": "The serving service's short name (absent when the generic handler\ndoes not carry one)."
          },
          "status": {
            "type": "string",
            "description": "Always `ok` on a live instance."
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Build identity id (`sentin8::build_info::id()`)."
          }
        }
      },
      "PolicyModeBody": {
        "type": "object",
        "description": "`POST /v1/admin/policy-sets/{mode}` body (RFW row actions).",
        "required": [
          "policy_set_name"
        ],
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "policy_set_name": {
            "type": "string"
          }
        }
      },
      "PolicySetDetail": {
        "type": "object",
        "description": "One policy set in the detail view (adds the full policy text).",
        "required": [
          "policy_set_name",
          "description",
          "policies",
          "origin",
          "mode",
          "version",
          "enabled",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "Creation instant (RFC 3339)."
          },
          "description": {
            "type": "string",
            "description": "Human description."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the set participates in evaluation."
          },
          "mode": {
            "type": "string",
            "description": "Evaluation mode."
          },
          "origin": {
            "type": "string",
            "description": "Row origin (`platform`/`tenant`)."
          },
          "policies": {
            "type": "string",
            "description": "The full policy text (Shield policy language)."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional schema text bound to the set."
          },
          "updated_at": {
            "type": "string",
            "description": "Last update instant (RFC 3339)."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Monotonic revision."
          }
        }
      },
      "PolicySetMutated": {
        "type": "object",
        "description": "A stored policy-set mutation result.",
        "required": [
          "policy_set_name",
          "version",
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "description": "The evaluation mode after the mutation."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "The revision after the mutation."
          }
        }
      },
      "PolicySetRow": {
        "type": "object",
        "description": "One policy set in the list view (the RFW row shape).",
        "required": [
          "id",
          "policy_set_name",
          "description",
          "origin",
          "mode",
          "version",
          "enabled",
          "policies_len",
          "updated_at"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human description."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the set participates in evaluation."
          },
          "id": {
            "type": "string",
            "description": "The set name; doubles as the RFW row id."
          },
          "mode": {
            "type": "string",
            "description": "Evaluation mode (`shadow`/`enforced`)."
          },
          "origin": {
            "type": "string",
            "description": "Row origin (`platform` enroll-managed vs `tenant`)."
          },
          "policies_len": {
            "type": "integer",
            "format": "int64",
            "description": "Number of policy statements in the set."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name."
          },
          "updated_at": {
            "type": "string",
            "description": "Last update instant (RFC 3339)."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Monotonic revision."
          }
        }
      },
      "PolicyTestOutcome": {
        "type": "object",
        "description": "A dry-run (test) outcome; nothing was stored.",
        "required": [
          "policy_set_name",
          "action",
          "decision",
          "would_deny"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "The action evaluated."
          },
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "description": "The enforce-mode decision."
          },
          "policy_set_name": {
            "type": "string",
            "description": "The set name the candidate text was compiled under."
          },
          "would_deny": {
            "type": "boolean",
            "description": "Whether the shadow evaluation would deny."
          }
        }
      },
      "PrincipalAttr": {
        "type": "object",
        "description": "One principal attribute in the list view.",
        "required": [
          "subject_id",
          "attr_key",
          "attr_value",
          "origin"
        ],
        "properties": {
          "attr_key": {
            "type": "string",
            "description": "The attribute key."
          },
          "attr_value": {
            "description": "The attribute value (free-form JSON by contract)."
          },
          "origin": {
            "type": "string",
            "description": "Row origin."
          },
          "subject_id": {
            "type": "string",
            "description": "The attribute owner (subject id)."
          }
        }
      },
      "PutAttributeBody": {
        "type": "object",
        "description": "`PUT /v1/admin/attributes` body - one principal attribute.",
        "required": [
          "subject_id",
          "attr_key",
          "attr_value"
        ],
        "properties": {
          "attr_key": {
            "type": "string"
          },
          "attr_value": {},
          "subject_id": {
            "type": "string"
          }
        }
      },
      "PutPolicySetBody": {
        "type": "object",
        "description": "`PUT /v1/admin/policy-sets/{name}` body.",
        "required": [
          "policies"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "policies": {
            "type": "string"
          },
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PutRelationBody": {
        "type": "object",
        "description": "`PUT /v1/admin/relations` body - one relation tuple.",
        "required": [
          "subject_type",
          "subject_id",
          "relation",
          "object_type",
          "object_id"
        ],
        "properties": {
