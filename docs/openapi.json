{
  "openapi": "3.1.0",
  "info": {
    "title": "email8-access",
    "description": "Sentin8 Email8:Access - IMAP, POP3, ManageSieve, CalDAV/CardDAV/WebDAV protocol services.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/dav": {
      "delete": {
        "tags": [
          "dav"
        ],
        "summary": "The bare `/dav` entry - axum's `Path<String>` cannot match zero\npath arguments, so the collection root gets its own wrapper.",
        "operationId": "dispatch_root",
        "responses": {
          "200": {
            "description": "DAV collection-root response (the bare /dav entry)"
          },
          "207": {
            "description": "Multi-Status (PROPFIND)"
          },
          "401": {
            "description": "Not authenticated"
          }
        },
        "security": [
          {
            "email8:access:dav": []
          }
        ]
      }
    },
    "/dav/{path}": {
      "delete": {
        "tags": [
          "dav"
        ],
        "summary": "The main DAV dispatcher: `/dav/{*path}` any-method.",
        "operationId": "dispatch",
        "responses": {
          "200": {
            "description": "DAV response (CalDAV/CardDAV over RFC 4918; request-body protocol)"
          },
          "207": {
            "description": "Multi-Status (PROPFIND)"
          },
          "401": {
            "description": "Not authenticated"
          }
        },
        "security": [
          {
            "email8:access:dav": []
          }
        ]
      }
    },
    "/v1/admin/attributes": {
      "get": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_list_attributes",
        "responses": {
          "200": {
            "description": "Principal attributes of this service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PrincipalAttr"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "put": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_put_attribute",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutAttributeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Attribute stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttributeUpserted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid attribute definition"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      },
      "delete": {
        "tags": [
          "policy"
        ],
        "operationId": "policy_delete_attribute",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Attribute id to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attribute deleted"
          },
          "403": {
            "description": "Caller lacks the admin scope"
          }
        },
        "security": [
          {
            "sentin8:admin": []
          }
        ]
      }
    },
    "/v1/admin/policy-sets": {
      "get": {
        "tags": [
